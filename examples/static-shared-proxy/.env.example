# Substack publication to fetch. Copy to .env and edit.
SUBSTACK_PUBLICATION_URL=https://fadlansthought.substack.com/

# This example routes the fetch through the SHARED public proxy (deployed
# from examples/worker-proxy) — GitHub Actions and other datacenter IPs get
# Cloudflare-403'd on direct requests. To fetch through YOUR OWN proxy
# instead, see examples/static-own-proxy and `npx astro-substack proxy`.
SUBSTACK_PROXY_URL=https://astro-substack-proxy.fadlank.web.id

# Optional. Omit SUBSTACK_LIMIT to fetch every post (Substack caps a single
# request at 50). Out-of-range values are clamped to 50 with a warning.
SUBSTACK_LIMIT=20

# One of: new | top | pinned | community
SUBSTACK_SORT=new
