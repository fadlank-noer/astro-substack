# Publication to fetch. Copy this file to .env and edit; omit it entirely to
# use the default (https://fadlansthought.substack.com/).
SUBSTACK_PUBLICATION_URL=https://fadlansthought.substack.com/

# Optional. Base URL of a fetch proxy — needed on CI/datacenter IPs, where
# Substack's Cloudflare 403-challenges direct feed requests. The shared
# public proxy (also available as proxy: "public" in code) is
# https://astro-substack-proxy.fadlank.web.id; or deploy your own from
# examples/worker-proxy.
SUBSTACK_PROXY_URL=
