# Substack publication to fetch. Copy to .env and edit.
SUBSTACK_PUBLICATION_URL=https://fadlansthought.substack.com/

# REQUIRED here: YOUR OWN proxy worker. Unlike examples/static-shared-proxy,
# this example has no shared default — leave it unset and the fetch goes
# direct, which Cloudflare 403-challenges on datacenter/VPS IPs.
#
# Scaffold your own worker with the CLI, then deploy it:
#
#   npx astro-substack proxy
#   cd worker-proxy && npx wrangler deploy
#
# Wrangler prints the URL (e.g. https://astro-substack-proxy.<your-subdomain>.workers.dev).
# Paste it below.
SUBSTACK_PROXY_URL=https://astro-substack-proxy.<your-subdomain>.workers.dev

# Optional. Omit SUBSTACK_LIMIT to fetch every post (Substack caps a single
# request at 50). Out-of-range values are clamped to 50 with a warning.
SUBSTACK_LIMIT=20

# One of: new | top | pinned | community
SUBSTACK_SORT=new
